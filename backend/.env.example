# Example configuration. Copy to .env for local runs.
# Never commit a real .env or real credentials.

# Listener. PORT is honored first, then the panel-assigned SERVER_PORT
# (injected by Botkeep/Pterodactyl-style eggs), then 3000. HOST defaults to
# 0.0.0.0 — required inside containers so the web proxy can reach the app;
# set 127.0.0.1 explicitly only for local loopback-only development.
PORT=
HOST=

# Cross-origin browser clients allowed by the API (comma-separated exact
# origins, scheme included). The deployed frontend origin is always allowed
# by default:
#   https://frontend-nine-rosy-15fjh5o7tt.vercel.app
# This list EXTENDS the defaults (custom domains, more frontends). Preflight
# (OPTIONS) replies echo the exact allowed origin, permitted methods
# (GET/HEAD/POST/PUT/PATCH/DELETE/OPTIONS) and headers
# (authorization, content-type). No credentials: auth is Bearer-token only.
CORS_ORIGINS=

# Required in production: at least 32 random characters.
JWT_SECRET=

# MongoDB Atlas storage (all platform data lives here; see the block below).

# Data plane: a real Redis server (recommended) — scheme optional ("host:6379"
# works; use rediss:// for TLS). The platform falls back to its own engine on
# MongoDB when this is unset.
REDIS_CONNECTION_STRING=

# Optional CA bundle (PEM) to trust for TLS providers with their own certificates.
REDIS_TLS_CA_FILE=./.config/ca.pem

# Quotas applied to newly registered users
QUOTA_MAX_DATABASES=
QUOTA_MAX_KEYS_PER_DB=
QUOTA_MAX_VALUE_BYTES=

# ---- Control plane + integrations ----

# MongoDB Atlas: REQUIRED. The whole control plane (users, databases, API keys,
# audit trail, profiles) is stored here; the platform refuses to boot without it.
MONGODB_URI=
# Brevo transactional email for signup email-verification codes.
# Without it the sender runs in MOCK mode (codes are surfaced locally, never emailed).
# When set, BREVO_SENDER_EMAIL (a verified Brevo sender) is required.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RedisHost

# Email-verification OTP tuning (defaults shown)
OTP_TTL_MS=600000
OTP_RESEND_COOLDOWN_MS=60000
OTP_MAX_ATTEMPTS=5

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=