    "description": "Multi-user Redis hosting platform: isolated Redis-compatible databases, per-user quotas, API keys, and admin control plane",
    "main": "server/index.js",
    "scripts": {
        "start": "node server/index.js",
        "dev": "node --watch server/index.js",
        "seed:admin": "node scripts/seed-admin.js",
