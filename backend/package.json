        "test:clients": "node tests/clients/run-all.mjs",
        "test:clients:docker": "node tests/clients/run-docker.mjs",
        "stress": "node scripts/stress-test.js"
    },
    "keywords": [
        "redis",
        "hosting",
        "multi-tenant"
    ],
    "author": "",
